# Backend Environment Variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NewsAPI Key - Get your free key from https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# JWT Secret - MUST be a valid Base64-encoded string (min 32 bytes / 256 bits)
# The default below is safe for development. Change it for production.
# Generate your own: echo -n "your-very-long-secret-key-here-32chars" | base64
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvck5ld3NBZ2dyZWdhdG9yQXBwMTIzNDU2Nzg5MA==

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
